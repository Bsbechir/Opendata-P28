import pandas as pd

file_path = 'df.pckl'

try:
    # Lecture du fichier pickle
    df = pd.read_pickle(file_path)
    
    # Affichage des 5 premières lignes pour vérifier le contenu
    print(df.head())
    
    # Optionnel: Afficher des informations sur les colonnes et les types de données
    print("\nInformations sur le DataFrame :")
    print(df.info())

except FileNotFoundError:
    print(f"Erreur : Le fichier '{file_path}' est introuvable. Vérifiez le chemin.")
except Exception as e:
    print(f"Une erreur s'est produite lors de la lecture du fichier : {e}")